<ResourceDictionary
    x:Class="Naztronomy.NINA.RemoteTelemetry.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Remote Telemetry_Options">
        <StackPanel Orientation="Vertical" Margin="10">

            <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="Telemetry server" />
            <TextBlock
                Margin="0,0,0,10"
                TextWrapping="Wrap"
                Text="Serves a read-only JSON API and a dashboard from this NINA instance. Intended for a private network such as Tailscale. Do not port-forward it to the internet." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding ServerEnabled}" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Text="Server enabled" />
            </StackPanel>

            <TextBlock
                Margin="0,0,0,10"
                FontStyle="Italic"
                TextWrapping="Wrap"
                Text="{Binding ServerStatus, StringFormat='Status: {0}'}" />

            <TextBlock Margin="0,5,0,2" Text="Port" />
            <TextBox
                MinWidth="120"
                HorizontalAlignment="Left"
                ToolTip="TCP port (1024-65535). Windows Firewall may ask to allow NINA the first time."
                Text="{Binding ServerPort, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Margin="0,10,0,2" Text="API key (optional)" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox
                    MinWidth="320"
                    VerticalAlignment="Center"
                    ToolTip="When set, API requests must send this key (X-Api-Key header or ?key=). Leave blank to allow anyone on the network."
                    Text="{Binding ApiKey, UpdateSourceTrigger=LostFocus}" />
                <Button
                    Margin="6,0,0,0"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    Content="Generate"
                    Command="{Binding GenerateApiKeyCommand}" />
            </StackPanel>

            <TextBlock Margin="0,10,0,2" Text="Allowed origins (CORS)" />
            <TextBox
                MinWidth="320"
                HorizontalAlignment="Left"
                ToolTip="Web pages allowed to call the API from a browser. Use * for any, or a comma-separated list such as http://100.101.102.103:8787"
                Text="{Binding AllowedOrigins, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Margin="0,10,0,2" Text="Preview max width (px)" />
            <TextBox
                MinWidth="120"
                HorizontalAlignment="Left"
                ToolTip="Width of the JPEG preview of the last saved frame."
                Text="{Binding PreviewMaxWidth, UpdateSourceTrigger=LostFocus}" />

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Padding="10,3" Content="Restart server" Command="{Binding RestartServerCommand}" />
                <Button Margin="6,0,0,0" Padding="10,3" Content="Open dashboard" Command="{Binding OpenDashboardCommand}" />
            </StackPanel>

            <TextBlock Margin="0,18,0,5" FontWeight="Bold" Text="HTTPS on your tailnet (Tailscale Serve)" />
            <TextBlock
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Text="Optionally also publishes the dashboard at https://&lt;this-pc&gt;.&lt;tailnet&gt;.ts.net:&lt;port&gt; with a certificate managed by Tailscale. Needed for the hosted dashboard (https pages cannot call http addresses) and for copying snapshots to the clipboard. Only devices on your tailnet can reach it; the plain LAN address keeps working. Requires MagicDNS and HTTPS Certificates enabled in the Tailscale admin console. Note: certificate names are published in public certificate logs." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding TailscaleServeEnabled}" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Serve the dashboard over HTTPS on my tailnet" />
            </StackPanel>
            <TextBlock Margin="0,6,0,2" Text="HTTPS port" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox
                    MinWidth="120"
                    VerticalAlignment="Center"
                    ToolTip="Port on the tailnet (default 8788). Using a dedicated port leaves any other Tailscale Serve setup on this PC untouched."
                    Text="{Binding TailscaleServePort, UpdateSourceTrigger=LostFocus}" />
                <Button Margin="6,0,0,0" Padding="10,3" VerticalAlignment="Center" Content="Check" Command="{Binding CheckTailscaleCommand}" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontStyle="Italic"
                TextWrapping="Wrap"
                Text="{Binding TailscaleStatus, StringFormat='Status: {0}'}" />

            <TextBlock Margin="0,18,0,5" FontWeight="Bold" Text="All-sky camera" />
            <TextBlock
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Text="Image shown on the dashboard's All-sky card. Use the camera's 'latest' image file, the folder it saves to (the newest .jpg/.png/.webp/.gif is used), or an http(s) URL. Leave blank to disable." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox
                    MinWidth="400"
                    VerticalAlignment="Center"
                    ToolTip="e.g. C:\allsky\latest.jpg, C:\allsky\images or http://allsky.local/image.jpg"
                    Text="{Binding AllSkySource, UpdateSourceTrigger=LostFocus}" />
                <Button Margin="6,0,0,0" Padding="10,3" VerticalAlignment="Center" Content="File…" Command="{Binding BrowseAllSkyFileCommand}" />
                <Button Margin="6,0,0,0" Padding="10,3" VerticalAlignment="Center" Content="Folder…" Command="{Binding BrowseAllSkyFolderCommand}" />
                <Button Margin="6,0,0,0" Padding="10,3" VerticalAlignment="Center" Content="Test" Command="{Binding TestAllSkyCommand}" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontStyle="Italic"
                TextWrapping="Wrap"
                Text="{Binding AllSkyStatus, StringFormat='Status: {0}'}" />

            <TextBlock Margin="0,18,0,5" FontWeight="Bold" Text="Target Scheduler" />
            <TextBlock
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Text="Adds the Scheduler cards (now, tonight's plan, project progress). Requires 'Enable API' in Target Scheduler's profile preferences. Its API is only called on this machine and is re-served through this plugin (with your API key)." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding TargetSchedulerEnabled}" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Target Scheduler integration enabled" />
            </StackPanel>
            <TextBlock Margin="0,6,0,2" Text="Target Scheduler API port" />
            <TextBox
                MinWidth="120"
                HorizontalAlignment="Left"
                ToolTip="Must match the API port in Target Scheduler's profile preferences (default 8188)."
                Text="{Binding TargetSchedulerPort, UpdateSourceTrigger=LostFocus}" />
            <TextBlock
                Margin="0,6,0,0"
                FontStyle="Italic"
                TextWrapping="Wrap"
                Text="{Binding TargetSchedulerStatus, StringFormat='Status: {0}'}" />

            <TextBlock Margin="0,18,0,5" FontWeight="Bold" Text="Reachable at" />
            <ItemsControl ItemsSource="{Binding DashboardUrls}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Text="{Binding Mode=OneWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
